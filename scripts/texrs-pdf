#!/usr/bin/env bash
# A .tex to a .pdf with texrs, for a build that already has the .tex.
#
# NOT a pandoc --pdf-engine, whatever it is named: pandoc validates that flag
# against a fixed list of engines it knows and refuses any other name --
#
#   $ pandoc t.md --pdf-engine=texrs-pdf -o t.pdf
#   Argument of --pdf-engine must be one of ...
#
# -- so texrs cannot be named there. It does not need to be. A pandoc book
# build already runs pandoc twice, once for the .tex and once for the .pdf,
# and the .tex from the first call is the whole input an engine needs. Point
# the build at this instead of the second pandoc call and it does one
# markdown->LaTeX pass rather than two.
#
# WHAT YOU GIVE UP by building a publication this way. Pages break by height
# and not by penalties, so a paragraph does not sit where tex puts it. There is
# no per-glyph font fallback, so a character the chosen face lacks does not get
# fetched from another one. A draft reads correctly; a book being SOLD on its
# typography should still be built by an engine with a stomach.
#
# What you do NOT give up any more: the face the document asked for is embedded
# rather than substituted, including a font shipped beside the document with
# fontspec Path=/UprightFont=, and \definecolor/\color/\pagecolor reach the
# page; and lines break the way tex.web S813 breaks them, by minimising total
# badness over every feasible sequence of breakpoints, with words hyphenated on
# Knuth's own patterns wherever the machine has a TeX installation to read them
# from. This is an order of magnitude faster, which is what it is for.
set -euo pipefail

tex_in=""
out_dir="."
for arg in "$@"; do
    case "$arg" in
        -output-directory=*|--output-directory=*) out_dir="${arg#*=}" ;;
        -*) : ;;                       # pandoc passes engine flags; ignore them
        *.tex) tex_in="$arg" ;;
    esac
done

if [[ -z "$tex_in" ]]; then
    echo "texrs-pdf: no .tex argument found in: $*" >&2
    exit 1
fi
if [[ ! -f "$tex_in" ]]; then
    echo "texrs-pdf: $tex_in: no such file" >&2
    exit 1
fi

command -v texrs >/dev/null || { echo "texrs-pdf: texrs not on PATH" >&2; exit 1; }

base="${tex_in%.tex}"
pdf="$base.pdf"

# --pdf, NOT --dvi. A DVI can only name a .tfm font, so that route sets the
# document in Computer Modern however loudly it said \setmainfont, and drops
# the colour with it. --pdf writes the file directly, names the face the
# document asked for, and carries \textcolor through as PDF's own operator.
texrs --pdf "$tex_in" >/dev/null

if [[ "$out_dir" != "." && -f "$pdf" ]]; then
    mkdir -p "$out_dir"
    mv -f "$pdf" "$out_dir/"
fi
