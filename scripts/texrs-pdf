#!/usr/bin/env bash
# texrs as a pandoc --pdf-engine.
#
# pandoc hands its --pdf-engine a .tex file and expects a .pdf beside it. texrs
# emits DVI, so this is the two steps that make it a PDF engine: texrs --dvi,
# then dvipdfmx. Both are what tex itself has always done; nothing here is a
# reimplementation of either.
#
#   pandoc book.md --pdf-engine=texrs-pdf -o book.pdf
#
# WHAT YOU GIVE UP by pointing a publication build at this. texrs is a mouth,
# an expander and a first-fit line breaker. It does not load fontspec, so the
# document is set in Computer Modern whatever \setmainfont asked for. It draws
# no TikZ, applies no colour, and breaks lines first-fit where tex minimises
# badness across a whole paragraph. A draft reads correctly; a book that is
# being SOLD on its typography should still be built by an engine with a
# stomach. This exists because it is 13x faster, which is worth having for the
# passes where you are reading the words rather than the page.
set -euo pipefail

tex_in=""
out_dir="."
for arg in "$@"; do
    case "$arg" in
        -output-directory=*|--output-directory=*) out_dir="${arg#*=}" ;;
        -*) : ;;                       # pandoc passes engine flags; ignore them
        *.tex) tex_in="$arg" ;;
    esac
done

if [[ -z "$tex_in" ]]; then
    echo "texrs-pdf: no .tex argument found in: $*" >&2
    exit 1
fi
if [[ ! -f "$tex_in" ]]; then
    echo "texrs-pdf: $tex_in: no such file" >&2
    exit 1
fi

command -v texrs >/dev/null || { echo "texrs-pdf: texrs not on PATH" >&2; exit 1; }
command -v dvipdfmx >/dev/null || { echo "texrs-pdf: dvipdfmx not on PATH (it ships with TeX Live)" >&2; exit 1; }

base="${tex_in%.tex}"
dvi="$base.dvi"
pdf="$base.pdf"

texrs --dvi "$tex_in" >/dev/null
# dvipdfmx writes beside the .dvi; -o keeps it there explicitly so a caller that
# passed an output directory gets the file where pandoc will look for it.
dvipdfmx -q -o "$pdf" "$dvi"

if [[ "$out_dir" != "." && -f "$pdf" ]]; then
    mkdir -p "$out_dir"
    mv -f "$pdf" "$out_dir/"
fi
