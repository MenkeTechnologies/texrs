#!/usr/bin/env bash
# texrs as a pandoc --pdf-engine.
#
# pandoc hands its --pdf-engine a .tex file and expects a .pdf beside it, and a
# pandoc book build already runs pandoc twice -- once for the .tex, once for the
# .pdf. This replaces the second call.
#
#   pandoc book.md --pdf-engine=texrs-pdf -o book.pdf
#
# WHAT YOU GIVE UP by pointing a publication build at this. The face a document
# asks for is honoured by METRICS, not by outline: \setmainfont{Arimo} sets in
# Helvetica, which carries Arial's widths, which are Arimo's -- the same shapes
# it is not. Lines break first-fit where tex minimises badness across a whole
# paragraph, and there is no hyphenation. A draft reads correctly; a book being
# SOLD on its typography should still be built by an engine with a stomach.
# This exists because it is an order of magnitude faster, which is worth having
# for the passes where you are reading the words rather than the page.
set -euo pipefail

tex_in=""
out_dir="."
for arg in "$@"; do
    case "$arg" in
        -output-directory=*|--output-directory=*) out_dir="${arg#*=}" ;;
        -*) : ;;                       # pandoc passes engine flags; ignore them
        *.tex) tex_in="$arg" ;;
    esac
done

if [[ -z "$tex_in" ]]; then
    echo "texrs-pdf: no .tex argument found in: $*" >&2
    exit 1
fi
if [[ ! -f "$tex_in" ]]; then
    echo "texrs-pdf: $tex_in: no such file" >&2
    exit 1
fi

command -v texrs >/dev/null || { echo "texrs-pdf: texrs not on PATH" >&2; exit 1; }

base="${tex_in%.tex}"
pdf="$base.pdf"

# --pdf, NOT --dvi. A DVI can only name a .tfm font, so that route sets the
# document in Computer Modern however loudly it said \setmainfont, and drops
# the colour with it. --pdf writes the file directly, names the face the
# document asked for, and carries \textcolor through as PDF's own operator.
texrs --pdf "$tex_in" >/dev/null

if [[ "$out_dir" != "." && -f "$pdf" ]]; then
    mkdir -p "$out_dir"
    mv -f "$pdf" "$out_dir/"
fi
