#compdef texrs
# Zsh completion for the texrs binary.
#
# The option set mirrors src/main.rs; a flag added there needs a line here or it
# completes to nothing.

_texrs() {
  _arguments -s \
    '-interaction=[how the engine behaves at an error]:mode:(batchmode nonstopmode scrollmode errorstopmode)' \
    '-jobname=[set the job name]:name:' \
    '-output-directory=[write files in this directory]:directory:_files -/' \
    '-progname=[set the program name]:name:' \
    '-fmt=[use a named format]:format:' \
    '-ini[be initex]' \
    '-halt-on-error[stop at the first error]' \
    '(-no-file-line-error)-file-line-error[file:line:error style messages]' \
    '(-file-line-error)-no-file-line-error[plain error messages]' \
    '-recorder[record the files read]' \
    '-X[run a texrs subcommand]:command:(new init build watch show dump bundle dvi bib bst tfm vf bibtex)' \
    '-8bit[write 8-bit characters as themselves]' \
    '(- *)--repl[start the interactive prompt]' \
    '(- *)--lsp[speak the Language Server Protocol over stdio]' \
    '(- *)--dap[speak the Debug Adapter Protocol over stdio]' \
    '(- *)--version[print the version banner and exit]' \
    '(- *)'{-h,--help}'[print the option grammar and exit]' \
    '(--disasm)--dump-tokens[print the mouth'\''s token stream and exit]' \
    '(--dump-tokens)--disasm[print the lowered fusevm bytecode and exit]' \
    '--aot[compile the document to a standalone native executable]' \
    '--tiers[run it, then report which fusevm tier took its bytecode]' \
    '--jobs=[compile several documents at once: N threads (default: one per core)]:count:' \
    '--build[compile into the bytecode cache and stop, without running]' \
    '--text[print the document text, not only its message stream]' \
    '--no-cache[compile this run rather than reading the bytecode cache]' \
    '(- *)--cache-stats[say what the bytecode cache holds and where, and exit]' \
    '(- *)--cache-clear[delete the bytecode cache and exit]' \
    '--profile[which output of the document to build (-X build, -X watch)]:profile:' \
    '--interval[how often -X watch looks for a change, in milliseconds]:milliseconds:' \
    '*:TeX file:_files -g "*.tex"'
}

_texrs "$@"
