    table)
  "Primitive name to the line eldoc shows for it.")

(defun texrs-stdlib-signature (name)
  "Return the eldoc line for primitive NAME, or nil."
  (and (stringp name) (gethash name texrs-stdlib--docs)))

(provide 'texrs-stdlib)
;;; texrs-stdlib.el ends here
